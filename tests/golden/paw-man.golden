.TH PAW 1 <DATE> paw "paw Manual"

.SH NAME
.PP
paw - Personal dotfiles manager


.SH SYNOPSIS
.PP
\fBpaw [flags]\fP


.SH DESCRIPTION
.PP
paw is a dotfiles manager for Linux, macOS, and WSL.


.SH OPTIONS
.PP
\fB--auto-update\fP[=false]
	Auto update during sync

.PP
\fB-n\fP, \fB--dry-run\fP[=false]
	Show what would be done

.PP
\fB-f\fP, \fB--force\fP[=false]
	Overwrite existing files

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for paw

.PP
\fB--json\fP[=false]
	JSON output mode

.PP
\fB--log-format\fP="text"
	Log format: text|json

.PP
\fB--no-interactive\fP[=false]
	Disable interactive prompts

.PP
\fB-p\fP, \fB--path\fP=""
	Path used by init command

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Quiet output

.PP
\fB--skip-hooks\fP[=false]
	Skip lifecycle hooks

.PP
\fB--skip-packages\fP[=false]
	Skip package installation

.PP
\fB--skip-update\fP[=false]
	Skip update check

.PP
\fB--skip-verify\fP[=false]
	Skip attestation verification in update

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output


